<Window x:Class="IpTvApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Player" Height="650" Width="1100"
        Background="{StaticResource BgApp}">
    <DockPanel>

        <!-- Top bar: profile + playlist inputs -->
        <!-- Top bar: profile + playlist inputs -->
<Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
        BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1">
    <StackPanel Margin="12,10">

        <!-- Always-visible row: profile picker + expand toggle -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="PROFILE" Style="{StaticResource LabelText}" Width="90" VerticalAlignment="Center" />
            <ComboBox x:Name="ProfileComboBox" Width="200"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProfileComboBox_SelectionChanged" />
            <Button Content="New" Click="NewProfileButton_Click" Margin="8,0,0,0" Width="70" />
            <Button Content="Delete" Click="DeleteProfileButton_Click" Margin="6,0,0,0" Width="70" />
        </StackPanel>

        <!-- Collapsible section: only shown when editing/setting up a profile -->
        <Expander x:Name="ProfileDetailsExpander" Header="Profile details" Foreground="{StaticResource TextSecondary}">
            <StackPanel Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="NAME" Style="{StaticResource LabelText}" Width="90" VerticalAlignment="Center" />
                    <TextBox x:Name="PlaylistNameBox" Width="200" Text="My IPTV" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="SERVER" Style="{StaticResource LabelText}" Width="90" VerticalAlignment="Center" />
                    <TextBox x:Name="PlaylistUrlBox" Width="400" Text="http://example.com:8080" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="USERNAME" Style="{StaticResource LabelText}" Width="90" VerticalAlignment="Center" />
                    <TextBox x:Name="UsernameBox" Width="200" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}" Width="90" VerticalAlignment="Center" />
                    <TextBox x:Name="PasswordInput" Width="200" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Profile" Style="{StaticResource PrimaryButton}"
                            Click="SaveProfileButton_Click" Width="120" />
                    <Button x:Name="LoadButton" Content="Load Playlist"
                            Click="LoadButton_Click" Margin="8,0,0,0" Width="110" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
            </StackPanel>
        </Expander>

    </StackPanel>
</Border>

        <!-- Bottom: transport controls -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="PlayPauseButton" Content="Pause" Style="{StaticResource TransportButton}"
                        Click="PlayPauseButton_Click" />
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource TransportButton}"
                        Click="StopButton_Click" />
                <TextBlock Text="VOL" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100"
                        Value="100" VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged" />
            </StackPanel>
        </Border>

        <!-- Left column 1: categories -->
        <Border DockPanel.Dock="Left" Width="240"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="CATEGORIES" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top" />
                <TextBox x:Name="CategorySearchBox" DockPanel.Dock="Top" Margin="12,0,12,8"
                         TextChanged="CategorySearchBox_TextChanged" />
                <ListBox x:Name="CategoryList" BorderThickness="0"
                         SelectionChanged="CategoryList_SelectionChanged" />
            </DockPanel>
        </Border>

        <!-- Left column 2: channels within selected category -->
        <Border DockPanel.Dock="Left" Width="280"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="CHANNELS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top" />
                <ListBox x:Name="ChannelList" DisplayMemberPath="Name"
                         SelectionChanged="ChannelList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </DockPanel>
        </Border>

        <!-- Remaining space: now-playing header + video -->
        <DockPanel Background="Black">
            <Border DockPanel.Dock="Top" Background="{StaticResource BgSurfaceRaised}"
                    BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Live}" VerticalAlignment="Center" />
                    <TextBlock x:Name="NowPlayingText" Text="No channel selected"
                               Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                               FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <vlc:VideoView x:Name="VideoView" />
        </DockPanel>

    </DockPanel>
</Window>
